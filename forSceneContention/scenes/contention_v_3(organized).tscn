[sub_resource type="GDScript" id="GDScript_w4b76"]
script/source = "extends Node3D

var aberto = false
var batidas = false

func _process(delta: float) -> void:
	if Global.tem_screwdriver and not aberto and not batidas:
		batidas = true
		$AnimationPlayer.play(\"bang\")

func interagir():
	if not aberto:
		$AnimationPlayer.play(\"open\")
		$\"../AudioStreamPlayer3D\".play()
		aberto = true
		if Global.tem_screwdriver:
			$\"../AudioStreamPlayer3D\".play()
	else:
		$AnimationPlayer.play_backwards(\"open\")
		$\"../AudioStreamPlayer3D\".play()
		aberto = false
	
"

